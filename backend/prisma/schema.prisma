generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  LIBRARIAN
  ADMINISTRATOR
}

enum LendingType {
  IN_LIBRARY
  HOME
}

enum LendingStatus {
  IN_PROGRESS
  RETURNED_ON_TIME
  RETURNED_LATE
  LOST
  OVERDUE
}

enum RefundStatus {
  PENDING
  REFUNDED
  FORFEITED
}

enum ReservationStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELED
}

enum FineStatus {
  PENDING
  PAID
  ANNULLED
}

enum PaymentMethod {
  BANKING_APP
  CASH
}

enum PenaltyType {
  MILD
  SEVERE
  VERY_SEVERE
}

enum PenaltyStatus {
  ACTIVE
  FULFILLED
  CANCELED
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  RESERVED
  LOST
}

enum BlockType {
  TEMPORARY
  PERMANENT
}

enum MovementType {
  INCREMENT
  DECREMENT
}

model SystemConfig {
  configId       String  @id @default(uuid())
  key            String  @unique
  value          String
  description    String?
}

model UserData {
  userDataId     String       @id @default(uuid())
  firstName          String
  paternalLastName   String
  maternalLastName   String
  documentType       String       @default("DNI")
  documentNumber     String       @unique
  maritalStatus      String?
  gender             String?
  isActive           Boolean      @default(true)
  birthDate          DateTime?
  mobilePhone        String?
  landlinePhone      String?
  email              String?      @unique

  address        String?
  addressId      String?
  districtId     String?
  
  addressRelation Address?     @relation(fields: [addressId], references: [addressId])
  district       District?    @relation(fields: [districtId], references: [districtId])
  user           User?
}

model User {
  userId      String   @id @default(uuid())
  userDataId  String   @unique
  role        UserRole
  code        String   @unique
  password    String
  confirmToken             String?
  confirmTokenExpires      DateTime?
  isConfirmed              Boolean  @default(false)
  resetPasswordToken       String?
  resetPasswordTokenExpires DateTime?

  userData    UserData @relation(fields: [userDataId], references: [userDataId])
  student     Student?
  teacher     Teacher?
  librarian   Librarian?
  administrator Administrator?

  reservations Reservation[]
  borrowedLendings Lending[] @relation("BorrowerLendings")
  processedLendings Lending[] @relation("ProcessedLendings")
  fines       Fine[]
  penalties   Penalty[]
  blocks      UserBlock[]
  stockHistories StockHistory[]
}

model Student {
  userId                  String  @id
  cycle                   String
  schoolId                String
  onTimeDeliveriesCount   Int     @default(0)
  consecutiveOnTimeReturns Int    @default(0)
  isAcademicRestricted    Boolean @default(false)

  user   User   @relation(fields: [userId], references: [userId])
  school School @relation(fields: [schoolId], references: [schoolId])
}

model Teacher {
  userId    String @id
  facultyId String
  department     String?
  specialization String?
  consecutiveOnTimeReturns Int @default(0)
  isAcademicRestricted    Boolean @default(false)

  user    User    @relation(fields: [userId], references: [userId])
  faculty Faculty @relation(fields: [facultyId], references: [facultyId])
}

model Librarian {
  userId String @id
  shift  String

  user User @relation(fields: [userId], references: [userId])
}

model Administrator {
  userId         String   @id
  dateAssignment DateTime

  user User @relation(fields: [userId], references: [userId])
}

model Address {
  addressId String @id @default(uuid())
  title     String

  users UserData[]
}

model District {
  districtId String @id @default(uuid())
  title      String
  provinceId String

  province Province @relation(fields: [provinceId], references: [provinceId])
  users    UserData[]
}

model Province {
  provinceId String @id @default(uuid())
  title      String

  districts District[]
}

model School {
  schoolId  String @id @default(uuid())
  title     String
  facultyId String

  faculty Faculty @relation(fields: [facultyId], references: [facultyId])
  students Student[]
}

model Faculty {
  facultyId String @id @default(uuid())
  title     String

  schools School[]
  teachers Teacher[]
}

model Reservation {
  reservationId   String             @id @default(uuid())
  userId          String
  copyId          String
  bookId          String
  lendingType     LendingType        @default(IN_LIBRARY)
  reservationDate DateTime           @default(now())
  expiresAt       DateTime
  status          ReservationStatus  @default(PENDING)
  qrToken         String?            @unique
  qrImageData     String?            @db.Text
  requestedReturnDate DateTime?
  plannedPickupDate   DateTime?

  user User @relation(fields: [userId], references: [userId])
  book Book @relation(fields: [bookId], references: [bookId])
  copy Copy @relation(fields: [copyId], references: [copyId])

  @@index([userId])
  @@index([bookId])
  @@index([copyId])
}

model UserType {
  userTypeId String   @id @default(uuid())
  name       UserRole @unique

  lendingPolicies LendingPolicy[]
}

model LendingPolicy {
  lendingPolicyId String      @id @default(uuid())
  userTypeId      String
  type            LendingType
  maxDays         Int
  maxItems        Int

  userType UserType @relation(fields: [userTypeId], references: [userTypeId])
  lendings  Lending[]
}

model Lending {
  lendingId             String          @id @default(uuid())
  copyId                String
  librarianUserId       String
  borrowerUserId        String
  lendingPolicyId       String
  lendingType           LendingType     @default(IN_LIBRARY)
  status                LendingStatus   @default(IN_PROGRESS)
  lendingDate           DateTime        @default(now())
  expectedReturnDate    DateTime?
  actualReturnDate      DateTime?
  lastUpdated           DateTime        @updatedAt
  depositAmount         Decimal?
  refundStatus          RefundStatus?
  qrToken               String?         @unique
  qrImageData           String?         @db.Text
  returnQrToken         String?         @unique
  returnQrImageData     String?         @db.Text
  returnQrExpiresAt     DateTime?
  returnedBookLost      Boolean         @default(false)
  daysOverdue           Int             @default(0)
  totalFineAmount       Decimal         @default(0)
  isQrScannedPickup     Boolean         @default(false)
  isQrScannedReturn     Boolean         @default(false)

  copy       Copy          @relation(fields: [copyId], references: [copyId])
  librarian  User          @relation("ProcessedLendings", fields: [librarianUserId], references: [userId])
  borrower   User          @relation("BorrowerLendings", fields: [borrowerUserId], references: [userId])
  policy     LendingPolicy @relation(fields: [lendingPolicyId], references: [lendingPolicyId])
  fine       Fine?

  @@index([copyId])
  @@index([librarianUserId])
  @@index([borrowerUserId])
  @@index([lendingPolicyId])
}

model Fine {
  fineId             String         @id @default(uuid())
  initialAmount      Decimal        @default(0)
  accumulatedAmount  Decimal        @default(0)
  isTemporary        Boolean        @default(false)
  userId             String
  lendingId          String         @unique
  issueDate          DateTime       @default(now())
  expiresAt          DateTime?
  paymentDate        DateTime?
  status             FineStatus     @default(PENDING)
  paymentMethod      PaymentMethod?

  user    User    @relation(fields: [userId], references: [userId])
  lending Lending @relation(fields: [lendingId], references: [lendingId])

  @@index([userId])
}

model Penalty {
  penaltyId       String        @id @default(uuid())
  userId          String
  lendingId       String?
  type            PenaltyType
  daysBlock       Int
  quantity        Int           @default(1)
  applicationDate DateTime      @default(now())
  endDate         DateTime?
  status          PenaltyStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model UserBlock {
  blockId   String    @id @default(uuid())
  userId    String
  blockType BlockType @default(TEMPORARY)
  startDate DateTime  @default(now())
  endDate   DateTime?
  reason    String?

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model Copy {
  copyId    String     @id @default(uuid())
  bookId    String
  status    CopyStatus @default(AVAILABLE)
  location  String
  barcode   String     @unique

  book Book @relation(fields: [bookId], references: [bookId])

  lendings     Lending[]
  reservations Reservation[]

  @@index([bookId])
}

model Book {
  bookId           String  @id @default(uuid())
  title            String
  isbn             String  @unique
  publicationYear  Int
  edition          String?
  language         String?
  pageCount        Int?
  price            Decimal @default(0)
  publisherId      String

  publisher    Publisher      @relation(fields: [publisherId], references: [publisherId])
  copies       Copy[]
  reservations Reservation[]
  authors      BookAuthor[]
  categories   BookCategory[]
  genres       BookGenre[]
  stockHistories StockHistory[]

  @@index([publisherId])
}

model Publisher {
  publisherId String @id @default(uuid())
  title       String

  books Book[]
}

model Author {
  authorId    String @id @default(uuid())
  firstName   String
  middleName  String?
  lastName    String
  nationality String?

  books BookAuthor[]
}

model Category {
  categoryId String @id @default(uuid())
  title      String

  books BookCategory[]
}

model Genre {
  genreId String @id @default(uuid())
  title   String

  books BookGenre[]
}

model BookAuthor {
  authorId String
  bookId   String

  author Author @relation(fields: [authorId], references: [authorId])
  book   Book   @relation(fields: [bookId], references: [bookId])

  @@id([authorId, bookId])
  @@index([bookId])
}

model BookCategory {
  categoryId String
  bookId     String

  category Category @relation(fields: [categoryId], references: [categoryId])
  book     Book     @relation(fields: [bookId], references: [bookId])

  @@id([categoryId, bookId])
  @@index([bookId])
}

model BookGenre {
  genreId String
  bookId  String

  genre Genre @relation(fields: [genreId], references: [genreId])
  book  Book  @relation(fields: [bookId], references: [bookId])

  @@id([genreId, bookId])
  @@index([bookId])
}

model StockHistory {
  historyId        String       @id @default(uuid())
  date             DateTime     @default(now())
  movementType     MovementType
  previousQuantity Int
  newQuantity      Int
  userId           String?
  bookId           String

  user             User?        @relation(fields: [userId], references: [userId])
  book             Book         @relation(fields: [bookId], references: [bookId])

  @@index([bookId])
  @@index([userId])
}
